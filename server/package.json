    "@types/luaparse": "^0.2.13",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.4.1",
    "drizzle-kit": "^0.31.5",
    "drizzle-orm": "^0.44.6",
    "jsonwebtoken": "^9.0.2",
    "luaparse": "^0.3.1",
    "superjson": "^2.2.2",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
