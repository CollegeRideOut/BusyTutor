{
  "name": "@busytutor/server",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "type": "commonjs",
  "scripts": {
    "db:push": "npx drizzle-kit push --config=./src/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio",
    "db:generate": "npx drizzle-kit generate --config=./src/db/drizzle.config.ts",
    "dev": "node -r ts-node/register src/index.ts",
    "build": "tsup src/index.ts --format esm --out-dir dist --clean",
    "start": "node dist/index.mjs",
    "test": "vitest",
    "clean": "rm -rf dist",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
