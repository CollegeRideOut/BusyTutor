{
  "compilerOptions": {
    /* base setup */
    "target": "ES2022",              // modern JS output
    "module": "CommonJS",              // allows import/export syntax
    "moduleResolution": "Bundler",   // works best in 2025 with Node + modern tools
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,

    /* folder structure */
    "rootDir": "src",
    "outDir": "dist",

    /* modern Node features */
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    /* optional, but nice if you want path aliases later */
    // "baseUrl": ".",
    // "paths": { "@/*": ["src/*"] }
  },
  "include": ["src"]
}
